# Project Zomboid Server Environment Configuration
# Copy this file to .env and edit the values below

# ──────────────────────────────────────────────
# Steam Beta Branch
# ──────────────────────────────────────────────
# Build 42 unstable branch
BETA_BRANCH=b42multiplayer

# Beta password (leave empty if not required)
BETA_PASSWORD=

# ──────────────────────────────────────────────
# Server Settings
# ──────────────────────────────────────────────
# Name of the server (used for save files)
SERVER_NAME=servertest

# Server join password (leave empty for no password)
SERVER_PASSWORD=

# Admin password (CHANGE THIS before running!)
ADMIN_PASSWORD=changeme

# Maximum number of players
MAX_PLAYERS=16

# Maximum RAM allocated to the server JVM
MAX_RAM=4096m

# ──────────────────────────────────────────────
# Port Mapping (host ports)
# ──────────────────────────────────────────────
SERVER_PORT=16261
SERVER_PORT_2=16262
